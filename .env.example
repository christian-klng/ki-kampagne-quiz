# Kopieren nach .env (lokal) bzw. in Coolify unter „Environment Variables“ eintragen.
# Ohne Token läuft das Quiz im Demo-Modus mit vorbereiteten Beispieltexten.

# --- Replicate (Sprachmodell und Bild-KI) ---
# Token unter https://replicate.com/account/api-tokens anlegen
REPLICATE_API_TOKEN=

# Sprachmodell: „owner/name“ (immer die aktuelle Version) oder „owner/name:version“ (fest angepinnt)
# LLM_MODEL=deepseek-ai/deepseek-v3   # Alternativen z. B. qwen/qwen3-235b-a22b-instruct-2507, anthropic/claude-opus-5.5 (teurer)
# LLM_TEMPERATURE=0.7                    # Abwechslung, falls das Modell es unterstützt
# LLM_EFFORT=low                         # nur Modelle mit „effort“ (z. B. Claude): low | medium | high
# LLM_INPUT_JSON={}                      # zusätzliche Modellparameter

# Bild-KI
# IMAGE_MODEL=black-forest-labs/flux-2-pro   # Alternativen z. B. black-forest-labs/flux-schnell (günstig, schnell)
# IMAGE_INPUT_JSON={"aspect_ratio":"1:1","output_format":"webp"}

# --- Kosten- und Missbrauchsschutz ---
# IMAGE_VARIANTS=3              # so viele Live-Bilder pro Antwortoption, danach aus dem Cache
# IMAGE_DAILY_LIMIT=50          # neue Bilder pro Tag insgesamt
# RATE_TEXT_PER_HOUR=200        # Anfragen pro IP und Stunde (Seminargruppen teilen oft eine IP)
# RATE_CHAT_PER_HOUR=100

# --- Server ---
# PORT=3000
# CACHE_DIR=./cache
